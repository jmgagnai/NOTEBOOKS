{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NG_BUILD_SASS_EMBEDDED=false ng serve",
    "build": "NG_BUILD_SASS_EMBEDDED=false ng build",
    "watch": "NG_BUILD_SASS_EMBEDDED=false ng build --watch --configuration development",
    "test": "NG_BUILD_SASS_EMBEDDED=false ng test --watch=false",
    "openapi:generate": "ng-openapi-gen --config ng-openapi-gen.json"
  },
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "marked": "^18.0.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
